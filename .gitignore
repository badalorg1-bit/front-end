# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Environment files (never commit secrets)
.env
.env.local
.env.server
.env.*.local
**/.env
**/.env.local
**/.env.server
**/.env.*.local

# Logs
*.log
**/*.log
dev.log
dev.err.log

# Editor/OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Playwright artifacts
.playwright-mcp/
**/.playwright-mcp/

# Local agent state
.kilo/
**/.kilo/

# Local backups and scratch
*-backup-*/
**/*-backup-*/
backup/
**/backup/
tmp/
**/tmp/
*.tmp

# Debug/scratch scripts and dumps (root only)
/dump_*.py
/dump_*.txt
/fix_*.py
/fix_*.mjs
/restore_*.py
/diag*.py
/diag*.mjs
/diag*.txt
/verify_backup*
/line313*
/tmp_*
/fix_result*
/*anon.png
/*anon.txt

# Screenshots and archives — ROOT ONLY.
# These MUST stay anchored ("/pattern"): `railway up` uploads by .gitignore,
# so an unanchored *.jpg would drop public/ (logo, favicon, product photos)
# from the Railway build and every image would 404 into the SPA fallback.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.ico
/*.pdf
/*.zip
/*.tar
/*.gz
/*.pdf

# Supabase local temp
supabase/.temp/
**/supabase/.temp/

# Railway/local tooling
railway.json

.vite
playwright-report
test-results
